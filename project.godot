; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Project Esensial"
run/main_scene="uid://di6pfrj7w1s7m"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://b7wjuo88htc78"

[autoload]

Transition="*res://UI/Scnee/Transition/transition.tscn"
GlobalSetting="*res://UI/Scnee/Setting/Script/GlobalSetting.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Level/": "green",
"res://Player/": "blue",
"res://Prefabs/": "pink",
"res://UI/": "green"
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
